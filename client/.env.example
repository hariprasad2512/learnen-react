# Copy this to .env and fill in your own values. Never commit .env.
# API base URL used by the frontend. Defaults in code to the Render deployment.
VITE_API_URL=http://localhost:3000/api

# EmailJS (Contact page) — https://www.emailjs.com/
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=
