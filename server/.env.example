# Copy this to .env and fill in your own values. Never commit .env.
MONGO_URL=mongodb://localhost:27017/learnen
# Or your Atlas URI:
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/learnen

# Razorpay (test mode) — https://dashboard.razorpay.com/app/keys
Key_Id=rzp_test_XXXX
KEY_SECRET=XXXX

# Server
PORT=3000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-me-in-dev

# Redis — local or Redis Cloud. If unset, code falls back to localhost:6379.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
